---
import {GoToUp} from "../components/go-to-up.tsx";
import CookieBanner from "../components/cookie-banner.tsx";
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" href="/favicon.ico"/>
    <title>Fabbro Lissone | Sostituzione, riparazione e pronto intervento</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">
</head>
<body class="bg-zinc-950/95">
<GoToUp client:load/>
<CookieBanner client:load/>
<slot/>
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        font-family: 'Outfit', sans-serif;
    }
</style>

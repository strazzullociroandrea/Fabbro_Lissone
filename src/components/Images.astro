---
import {Image as AstroImage} from 'astro:assets';
import imm1 from '../assets/imm1.jpeg';
import imm2 from '../assets/imm2.jpeg';
import imm3 from '../assets/imm3.jpeg';
import imm4 from '../assets/imm4.jpeg';
import imm5 from '../assets/imm5.jpeg';
import {Camera, ArrowUpRight} from "lucide-react";

const immagini = [
    {src: imm1, alt: "Intervento su serratura e porta blindata"},
    {src: imm2, alt: "Dettaglio lavorazione fabbro"},
    {src: imm3, alt: "Sostituzione e riparazione serrature"},
    {src: imm4, alt: "Apertura porte e casseforti"},
    {src: imm5, alt: "Installazione componenti di sicurezza"},
];
---

<section id="immagini" class="relative w-full bg-zinc-950 py-20 sm:py-28 border-b border-zinc-800 overflow-hidden">

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class=" mb-16">
            <div class="inline-flex items-center gap-2 rounded-full bg-sky-500/10 px-4 py-1.5 text-xs font-semibold text-sky-400 mb-4 border border-sky-500/20">
                <Camera className="h-3.5 w-3.5"/>
                <span>Galleria Fotografica</span>
            </div>
            <h2 class="uppercase text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
                I Nostri <span class="text-sky-400">Lavori</span>
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 auto-rows-[240px]">

            <div class="group relative overflow-hidden rounded-3xl bg-zinc-900 border border-zinc-800 shadow-xl md:col-span-2 md:row-span-2">
                <AstroImage
                        src={immagini[0].src}
                        alt={immagini[0].alt}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter brightness-90 group-hover:brightness-100"
                />
            </div>

            <div class="group relative overflow-hidden rounded-3xl bg-zinc-900 border border-zinc-800 shadow-xl md:col-span-1 md:row-span-1">
                <AstroImage
                        src={immagini[1].src}
                        alt={immagini[1].alt}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter brightness-90 group-hover:brightness-100"
                />
            </div>

            <div class="group relative overflow-hidden rounded-3xl bg-zinc-900 border border-zinc-800 shadow-xl md:col-span-1 md:row-span-1">
                <AstroImage
                        src={immagini[2].src}
                        alt={immagini[2].alt}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter brightness-90 group-hover:brightness-100"
                />
            </div>

            <div class="group relative overflow-hidden rounded-3xl bg-zinc-900 border border-zinc-800 shadow-xl md:col-span-1 md:row-span-1">
                <AstroImage
                        src={immagini[3].src}
                        alt={immagini[3].alt}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter brightness-90 group-hover:brightness-100"
                />
            </div>

            <div class="group relative overflow-hidden rounded-3xl bg-zinc-900 border border-zinc-800 shadow-xl md:col-span-1 md:row-span-1">
                <AstroImage
                        src={immagini[4].src}
                        alt={immagini[4].alt}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter brightness-90 group-hover:brightness-100"
                />
            </div>

        </div>

    </div>
</section>
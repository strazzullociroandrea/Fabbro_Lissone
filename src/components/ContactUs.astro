---
import {Phone, MapPin, Clock, MessageCircle} from "lucide-react";
---

<section id="contatti" class="relative w-full bg-zinc-950 py-20 sm:py-28 border-b border-zinc-800 overflow-hidden">

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
            <div>
                <div class="inline-flex items-center gap-2 rounded-full bg-sky-500/10 px-4 py-1.5 text-xs font-semibold text-sky-400 mb-4 border border-sky-500/20">
                    <MessageCircle className="h-3.5 w-3.5"/>
                    <span>Come trovarci</span>
                </div>
                <h2 class="uppercase text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
                    Conta<span class="text-sky-400">ttaci</span>
                </h2>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">

            <div class="bg-zinc-900/80 backdrop-blur-sm rounded-3xl p-6 shadow-xl border border-zinc-800/80 hover:border-zinc-700 transition-colors flex flex-col items-center text-center">
                <div class="bg-sky-500/10 border border-sky-500/20 w-12 h-12 rounded-2xl flex items-center justify-center text-sky-400 mb-4">
                    <Phone className="h-5 w-5"/>
                </div>
                <h3 class="text-xs uppercase font-bold tracking-wider text-zinc-400 mb-1">Telefono</h3>
                <a href="tel:3333102133"
                   class="text-white">
                    333 310 2133
                </a>
            </div>

            <div class="bg-zinc-900/80 backdrop-blur-sm rounded-3xl p-6 shadow-xl border border-zinc-800/80 hover:border-zinc-700 transition-colors flex flex-col items-center text-center">
                <div class="bg-sky-500/10 border border-sky-500/20 w-12 h-12 rounded-2xl flex items-center justify-center text-sky-400 mb-4">
                    <MapPin className="h-5 w-5"/>
                </div>
                <h3 class="text-xs uppercase font-bold tracking-wider text-zinc-400 mb-1">Zona di Intervento</h3>
                <p class="text-white">Lissone (MB)</p>
            </div>

            <div class="bg-zinc-900/80 backdrop-blur-sm rounded-3xl p-6 shadow-xl border border-zinc-800/80 hover:border-zinc-700 transition-colors flex flex-col items-center text-center">
                <div class="bg-sky-500/10 border border-sky-500/20 w-12 h-12 rounded-2xl flex items-center justify-center text-sky-400 mb-4">
                    <Clock className="h-5 w-5"/>
                </div>
                <h3 class="text-xs uppercase font-bold tracking-wider text-zinc-400 mb-1">Orari di Apertura</h3>
                <div class="text-sm text-zinc-300 font-medium space-y-0.5">
                    <p>Lun - Ven: 07:30 - 20:00</p>
                    <p>Sabato: 08:00 - 20:00</p>
                </div>
            </div>

        </div>

        <div class="bg-zinc-900/90 backdrop-blur-sm rounded-3xl p-8 shadow-2xl border border-zinc-800 text-center flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="text-left">
                <h3 class="text-lg font-bold text-white mb-1">Hai bisogno di un fabbro?</h3>
                <p class="text-zinc-400 text-sm font-light">Contattaci per qualsiasi richiesta di intervento a
                    Lissone.</p>
            </div>
            <a
                    href="tel:3333102133"
                    class="group inline-flex shrink-0 items-center justify-center space-x-3 bg-sky-500 hover:bg-sky-400 text-white px-8 py-4 rounded-2xl font-bold shadow-lg shadow-sky-500/25 active:scale-95 transition-all text-base sm:text-lg"
            >
                <div class="p-1 bg-white/20 rounded-xl group-hover:rotate-12 transition-transform">
                    <Phone className="h-5 w-5 text-white"/>
                </div>
                <span>Chiama il 333 310 2133</span>
            </a>
        </div>

    </div>
</section>
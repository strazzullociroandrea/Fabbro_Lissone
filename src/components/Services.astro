---
import {ArrowRight, DoorOpen, KeyRound, Vault, Scale, Blinds, ShieldAlert} from "lucide-react";

const services = [
    {
        icon: DoorOpen,
        title: "Apertura Porte",
        description: "Apertura di porte bloccate o con chiave spezzata senza danni alla struttura, tramite tecniche professionali.",
        badge: "01 / Servizio",
    },
    {
        icon: KeyRound,
        title: "Sostituzione Serrature",
        description: "Installazione e aggiornamento a serrature di ultima generazione con cilindro europeo di massima sicurezza.",
        badge: "02 / Servizio",
    },
    {
        icon: Vault,
        title: "Apertura Casseforti",
        description: "Servizio specializzato di sblocco e apertura casseforti con la massima riservatezza e competenza.",
        badge: "03 / Servizio",
    },
    {
        icon: Scale,
        title: "Assistenza Sfratti",
        description: "Collaborazione puntuale e professionale con gli Enti e ufficiali giudiziari per aperture e cambi serratura.",
        badge: "04 / Servizio",
    },
    {
        icon: Blinds,
        title: "Serrande e Tapparelle",
        description: "Riparazione urgente, sblocco, manutenzione e motorizzazione di serrande commerciali e tapparelle domestiche.",
        badge: "05 / Servizio",
    },
];
---

<section id="servizi" class="relative w-full bg-zinc-950 py-20 sm:py-28 border-b border-zinc-800 overflow-hidden">

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
            <div class="max-w-2xl">
                <h2 class="uppercase text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
                    I Nostri <span class="text-sky-400">Servizi</span>
                </h2>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {services.map((service, index) => (
                    <div class={`group relative rounded-3xl p-8 transition-all duration-300 flex flex-col justify-between border ${service.highlight ? 'bg-sky-500/10 border-sky-500/30' : 'bg-zinc-900 border-zinc-800/50'} hover:shadow-lg hover:shadow-sky-500/20 hover:-translate-y-1`}
                         key={index}>

                        <div>
                            <div class="flex items-center justify-between mb-6">

                                <span class={`text-xs font-semibold px-3 py-1 rounded-full border ${
                                    service.highlight
                                        ? 'bg-sky-500/20 text-sky-300 border-sky-500/30'
                                        : 'bg-zinc-800 text-zinc-400 border-zinc-700/50'
                                }`}>
                                {service.badge}

                            </span>
                                <div>
                                    <service.icon className="w-6 h-6 text-sky-400"/>
                                </div>
                            </div>

                            <h3 class="text-xl font-bold text-white mb-3 tracking-tight group-hover:text-sky-400 transition-colors">
                                {service.title}
                            </h3>
                            <p class="text-zinc-400 text-sm leading-relaxed font-light">
                                {service.description}
                            </p>
                        </div>

                        <div class="mt-8 pt-6 border-t border-zinc-800/80">
                            <a href="tel:3333102133"
                               class="flex items-center justify-between group/link w-full py-1 text-xs font-bold uppercase tracking-wider text-white hover:text-sky-400 transition-colors">
                                <span>Chiama per il servizio</span>
                                <div class={`w-8 h-8 rounded-xl flex items-center justify-center transition-all duration-300 ${
                                    service.highlight
                                        ? 'bg-sky-500 text-white group-hover/link:translate-x-1'
                                        : 'bg-zinc-800 text-zinc-300 group-hover/link:bg-sky-500 group-hover/link:text-white group-hover/link:translate-x-1'
                                }`}>
                                    <ArrowRight className="w-4 h-4"/>
                                </div>
                            </a>
                        </div>

                    </div>
            ))}
        </div>

    </div>
</section>
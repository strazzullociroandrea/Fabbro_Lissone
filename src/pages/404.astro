---
import Layout from '../layouts/Layout.astro';
import {Home, Phone, ShieldAlert} from 'lucide-react';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<Layout>
    <div class="min-h-screen flex flex-col justify-between bg-zinc-950 text-white">
         <header id="header" class="sticky top-0 z-50 bg-zinc-950/95 backdrop-blur-md border-b border-zinc-800">
            <Header/>
        </header>

         <main class="grow flex items-center justify-center">
            <section id="hero" class="relative w-full bg-zinc-950 py-20 sm:py-32 overflow-hidden">

                <div class="relative mx-auto flex w-full max-w-7xl flex-col items-center justify-center px-4 sm:px-6 lg:px-8 text-center">

                    <div class="inline-flex items-center justify-center w-24 h-24 rounded-3xl bg-sky-500/10 border border-sky-500/20 text-sky-400 mb-8 shadow-xl shadow-sky-950/50">
                        <ShieldAlert className="w-12 h-12"/>
                    </div>

                    <div class="inline-block px-4 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 font-extrabold text-xs uppercase tracking-wider mb-4 shadow-sm">
                        Errore 404
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white mb-6">
                        Pagina <span class="text-sky-400">Non Trovata</span>
                    </h1>

                    <p class="text-zinc-400 text-base sm:text-lg mb-10 max-w-md mx-auto leading-relaxed font-light">
                        Spiacenti, la pagina che stai cercando non esiste, è stata rimossa o l'indirizzo inserito non è corretto.
                    </p>
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
                        <a
                                href="/"
                                class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 rounded-2xl bg-sky-500 hover:bg-sky-400 px-8 py-4 text-base font-bold text-white shadow-lg shadow-sky-500/25 transition-all active:scale-95"
                        >
                            <Home className="h-5 w-5"/>
                            <span>Vai alla Home</span>
                        </a>

                        <a
                                href="tel:3333102133"
                                class="w-full sm:w-auto group inline-flex items-center justify-center space-x-2 rounded-2xl bg-zinc-900 hover:bg-zinc-800 px-8 py-4 text-base font-bold text-white transition-all border border-zinc-800 active:scale-95 shadow-lg"
                        >
                            <div class="p-1 bg-sky-500/10 text-sky-400 rounded-xl group-hover:rotate-12 transition-transform">
                                <Phone className="h-4 w-4"/>
                            </div>
                            <span>Chiamaci</span>
                        </a>
                    </div>

                </div>
            </section>
        </main>

        <!-- Footer -->
        <footer id="footer">
            <Footer/>
        </footer>
    </div>
</Layout>
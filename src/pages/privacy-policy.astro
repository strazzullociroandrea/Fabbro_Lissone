---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {Building, Phone, Shield, Lock, FileText, Server, AlertTriangle, ArrowLeft} from "lucide-react";
---

<Layout title="Privacy Policy | Fabbro Lissone">
    <div class="min-h-screen flex flex-col justify-between bg-zinc-950 text-white selection:bg-sky-500 selection:text-white">
        <header id="header" class="sticky top-0 z-50 bg-zinc-950/90 backdrop-blur-xl border-b border-zinc-800/80">
            <Header/>
        </header>

        <main id="main" class="grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">

            <div class="mb-12">
                <a
                        href="javascript:history.back()"
                        class="inline-flex items-center space-x-2.5 px-4 py-2.5 rounded-2xl bg-zinc-900/90 hover:bg-zinc-800 text-zinc-300 hover:text-white font-medium text-xs tracking-wider uppercase transition-all border border-zinc-800 shadow-lg active:scale-95 group cursor-pointer"
                >
                    <ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1 text-sky-400"/>
                    <span>Torna Indietro</span>
                </a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

                <div class="lg:col-span-4 lg:sticky lg:top-28 space-y-6">
                    <div class="inline-flex items-center justify-center p-3.5 bg-sky-500/10 rounded-2xl text-sky-400 border border-sky-500/20 shadow-xl shadow-sky-950/50">
                        <Shield className="w-8 h-8"/>
                    </div>

                    <h1 class="text-4xl sm:text-5xl font-black tracking-tight leading-[1.05] text-white">
                        Privacy <span class="text-transparent bg-clip-text bg-linear-to-r from-sky-400 to-blue-500">Policy</span>
                    </h1>

                    <p class="text-zinc-400 text-base leading-relaxed font-light">
                        Informativa sul trattamento dei dati personali ai sensi del Regolamento (UE) 2016/679 (GDPR).
                    </p>

                    <div class="pt-4 border-t border-zinc-800/80 flex flex-col gap-3">
                        <div class="flex items-center gap-2 text-xs text-zinc-400 font-medium">
                            <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
                            <span>Ultimo aggiornamento: 05 ottobre 2026</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-8 space-y-10">

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Building className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 01</span>
                                <h2 class="text-xl font-extrabold text-white">Titolare del Trattamento dei Dati</h2>
                            </div>
                        </div>
                        <div class="grid sm:grid-cols-2 gap-6 text-sm text-zinc-300 font-light pl-0 sm:pl-15">
                            <div class="space-y-3">
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Attività:</strong>
                                    <span class="text-white font-medium">Fabbro Lissone</span>
                                    <span class="block text-xs text-zinc-400 mt-0.5">marchio di proprietà di Luciano, P.IVA 09082580961</span>
                                </div>
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Partita IVA:</strong>
                                    <span class="text-white font-medium">09082580961</span>
                                </div>
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Sede legale:</strong>
                                    <span class="text-white font-medium">Via Gran Paradiso 4, Brugherio</span>
                                </div>
                            </div>
                            <div class="space-y-3">
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Telefono:</strong>
                                    <a href="tel:3333102133" class="text-sky-400 font-bold hover:underline">333 310
                                        2133</a>
                                </div>
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Email:</strong>
                                    <a href="mailto:info@lissoneserrature.it"
                                       class="text-sky-400 font-bold hover:underline">info@lissoneserrature.it</a>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <FileText className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 02</span>
                                <h2 class="text-xl font-extrabold text-white">Tipologie di Dati Raccolti e Finalità</h2>
                            </div>
                        </div>
                        <div class="space-y-4 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                Il sito non raccoglie dati personali tramite moduli online, strumenti di analisi
                                complessi o profilazione commerciale. Possono essere trattati i dati tecnici necessari
                                alla sicurezza e al funzionamento del sito, oltre ai dati che l'utente comunica
                                volontariamente tramite telefono o email.
                            </p>
                            <div class="grid sm:grid-cols-2 gap-4 pt-2">
                                <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800/80">
                                    <h3 class="font-bold text-white mb-2 flex items-center gap-2">
                                        <Phone className="w-4 h-4 text-sky-400"/>
                                        Pulsante "Chiama"
                                    </h3>
                                    <p class="text-xs text-zinc-400 leading-relaxed">
                                        Apre l'applicazione telefonica del dispositivo. Nessun dato personale viene
                                        memorizzato o raccolto dai nostri server durante questa operazione.
                                    </p>
                                </div>
                                <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800/80">
                                    <h3 class="font-bold text-white mb-2 flex items-center gap-2">
                                        <span class="text-sky-400">📊</span> Google Search Console
                                    </h3>
                                    <p class="text-xs text-zinc-400 leading-relaxed">
                                        Servizio di analisi tecnica e statistica di Google per monitorare il rendimento
                                        del sito sui motori di ricerca, trattando dati tecnici e aggregati.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Lock className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 03</span>
                                <h2 class="text-xl font-extrabold text-white">Cookie e Servizi di Terze Parti</h2>
                            </div>
                        </div>
                        <div class="space-y-4 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                Il sito non utilizza cookie di profilazione o marketing. Vengono impiegati
                                esclusivamente strumenti tecnici necessari al funzionamento:
                            </p>
                            <ul class="grid sm:grid-cols-2 gap-4 pt-2">
                                <li class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800/80">
                                    <strong class="block text-white mb-1 font-semibold">localStorage</strong>
                                    <span class="text-xs text-zinc-400 leading-relaxed">Memorizzazione locale della scelta effettuata sul banner cookie. Non è un cookie e non trasmette dati a terzi.</span>
                                </li>
                                <li class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800/80">
                                    <strong class="block text-white mb-1 font-semibold">Log tecnici del server</strong>
                                    <span class="text-xs text-zinc-400 leading-relaxed">Il provider di hosting può trattare indirizzo IP, data e ora della richiesta e dati tecnici per sicurezza.</span>
                                </li>
                            </ul>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Server className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 04</span>
                                <h2 class="text-xl font-extrabold text-white">Modalità, Base Giuridica e
                                    Conservazione</h2>
                            </div>
                        </div>
                        <div class="space-y-3 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                Il trattamento dei dati tecnici si fonda sul <strong class="text-white font-medium">legittimo
                                interesse del Titolare</strong> (art. 6 par. 1 lett. f del GDPR) volto a garantire la
                                sicurezza e la corretta erogazione del sito. I dati comunicati volontariamente sono
                                trattati esclusivamente per rispondere alle richieste dell'utente.
                            </p>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Shield className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 05</span>
                                <h2 class="text-xl font-extrabold text-white">Diritti dell'Interessato</h2>
                            </div>
                        </div>
                        <div class="space-y-6 pl-0 sm:pl-15">
                            <p class="text-sm text-zinc-300 font-light leading-relaxed">
                                Gli utenti possono esercitare in qualsiasi momento i diritti previsti dagli <strong
                                    class="text-white font-medium">articoli 15-22 del GDPR</strong> (accesso, rettifica,
                                cancellazione, limitazione, opposizione e portabilità) rivolgendosi direttamente al
                                Titolare tramite email.
                            </p>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
                                {["Diritto di Accesso", "Rettifica Dati", "Cancellazione (Oblio)", "Limitazione Trattamento", "Opposizione", "Portabilità dei Dati"].map((dir) => (
                                        <div class="p-3.5 rounded-xl bg-zinc-950/80 border border-zinc-800 font-medium text-zinc-300 text-center">
                                            {dir}
                                        </div>
                                ))}
                            </div>
                        </div>
                    </section>

                    <div class="rounded-3xl bg-zinc-950/60 p-6 border border-zinc-800/80 text-xs text-zinc-400 font-light space-y-2">
                        <div class="flex items-center gap-2 text-white font-bold uppercase tracking-wider">
                            <AlertTriangle className="w-4 h-4 text-sky-400"/>
                            Nota Tecnica
                        </div>
                        <p class="leading-relaxed">
                            Il Webmaster fornisce esclusivamente il supporto tecnico e la gestione dello spazio server.
                            Il Webmaster non è responsabile dei contenuti commerciali o delle trattative intercorse tra
                            gli utenti e l'azienda, restando quest'ultima l'unica responsabile per i servizi erogati e
                            il trattamento dei dati personali.
                        </p>
                    </div>

                </div>

            </div>
        </main>

        <footer id="footer">
            <Footer/>
        </footer>
    </div>
</Layout>
---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {Cookie, FileText, Server, HelpCircle, Building, AlertTriangle, ArrowLeft, ShieldCheck} from "lucide-react";
---

<Layout title="Cookie Policy | Fabbro Lissone">
    <div class="min-h-screen flex flex-col justify-between bg-zinc-950 text-white selection:bg-sky-500 selection:text-white">
        <header id="header" class="sticky top-0 z-50 bg-zinc-950/90 backdrop-blur-xl border-b border-zinc-800/80">
            <Header/>
        </header>

        <main class="grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">

            <div class="mb-12">
                <a
                        href="javascript:history.back()"
                        class="inline-flex items-center space-x-2.5 px-4 py-2.5 rounded-2xl bg-zinc-900/90 hover:bg-zinc-800 text-zinc-300 hover:text-white font-medium text-xs tracking-wider uppercase transition-all border border-zinc-800 shadow-lg active:scale-95 group"
                >
                    <ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1 text-sky-400"/>
                    <span>Torna Indietro</span>
                </a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

                <div class="lg:col-span-4 lg:sticky lg:top-28 space-y-6">
                    <div class="inline-flex items-center justify-center p-3.5 bg-sky-500/10 rounded-2xl text-sky-400 border border-sky-500/20 shadow-xl shadow-sky-950/50">
                        <Cookie className="w-8 h-8"/>
                    </div>

                    <h1 class="text-4xl sm:text-5xl font-black tracking-tight leading-[1.05] text-white">
                        Cookie <span class="text-transparent bg-clip-text bg-linear-to-r from-sky-400 to-blue-500">Policy</span>
                    </h1>

                    <p class="text-zinc-400 text-base leading-relaxed font-light">
                        Trasparenza e chiarezza sull'utilizzo dei cookie e degli strumenti di navigazione sul nostro
                        portale.
                    </p>

                    <div class="pt-4 border-t border-zinc-800/80 flex flex-col gap-3">
                        <div class="flex items-center gap-2 text-xs text-zinc-400 font-medium">
                            <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
                            <span>Ultimo aggiornamento: 5 ottobre 2026</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-8 space-y-10">

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <FileText className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 01</span>
                                <h2 class="text-xl font-extrabold text-white">Cosa sono i Cookie</h2>
                            </div>
                        </div>
                        <div class="space-y-4 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                I cookie sono piccoli file di testo che vengono memorizzati sul tuo dispositivo quando
                                visiti un sito web. Permettono al sito di ricordare le tue preferenze e migliorare la
                                tua esperienza di navigazione.
                            </p>
                            <p class="text-zinc-400">
                                Il presente sito utilizza esclusivamente cookie tecnici necessari al funzionamento e
                                strumenti statistici anonimi, senza ricorrere a cookie di profilazione o tracciamento
                                commerciale.
                            </p>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Cookie className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 02</span>
                                <h2 class="text-xl font-extrabold text-white">Tipologie di Cookie e Tecnologie</h2>
                            </div>
                        </div>
                        <div class="space-y-4 text-sm text-zinc-300 leading-relaxed pl-0 sm:pl-15">
                            <div class="grid sm:grid-cols-2 gap-4">
                                <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800/80">
                                    <h3 class="font-bold text-white mb-2 flex items-center gap-2">
                                        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                                        Cookie Tecnici
                                    </h3>
                                    <p class="text-xs text-zinc-400 font-light leading-relaxed">
                                        Essenziali per la navigazione e per memorizzare le preferenze tecniche
                                        dell'utente. Non richiedono consenso preventivo.
                                    </p>
                                </div>
                                <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800/80">
                                    <h3 class="font-bold text-white mb-2 flex items-center gap-2">
                                        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                        Strumenti Statistici
                                    </h3>
                                    <p class="text-xs text-zinc-400 font-light leading-relaxed">
                                        Sistemi di analisi tecnica e statistica aggregata per monitorare il rendimento
                                        del sito sui motori di ricerca senza tracciare i singoli utenti.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Server className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 03</span>
                                <h2 class="text-xl font-extrabold text-white">Gestione tramite Browser</h2>
                            </div>
                        </div>
                        <div class="space-y-4 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                L'utente può gestire o eliminare i cookie direttamente attraverso le impostazioni del
                                proprio browser. Di seguito i collegamenti alle guide ufficiali:
                            </p>
                            <div class="grid grid-cols-2 gap-3 text-xs font-semibold pt-2">
                                <a href="https://support.google.com/chrome/answer/95647?hl=it" target="_blank"
                                   rel="noreferrer"
                                   class="p-3.5 rounded-xl bg-zinc-950/80 border border-zinc-800 text-center text-zinc-300 hover:text-white hover:border-sky-500/50 transition-all flex items-center justify-center gap-2">
                                    Google Chrome
                                </a>
                                <a href="https://support.mozilla.org/it/kb/Gestione%20dei%20cookie" target="_blank"
                                   rel="noreferrer"
                                   class="p-3.5 rounded-xl bg-zinc-950/80 border border-zinc-800 text-center text-zinc-300 hover:text-white hover:border-sky-500/50 transition-all flex items-center justify-center gap-2">
                                    Mozilla Firefox
                                </a>
                                <a href="https://support.apple.com/kb/HT1677?viewlocale=it_IT" target="_blank"
                                   rel="noreferrer"
                                   class="p-3.5 rounded-xl bg-zinc-950/80 border border-zinc-800 text-center text-zinc-300 hover:text-white hover:border-sky-500/50 transition-all flex items-center justify-center gap-2">
                                    Apple Safari
                                </a>
                                <a href="https://support.microsoft.com/it-it/windows/eliminare-e-gestire-i-cookie"
                                   target="_blank" rel="noreferrer"
                                   class="p-3.5 rounded-xl bg-zinc-950/80 border border-zinc-800 text-center text-zinc-300 hover:text-white hover:border-sky-500/50 transition-all flex items-center justify-center gap-2">
                                    Microsoft Edge
                                </a>
                            </div>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <HelpCircle className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 04</span>
                                <h2 class="text-xl font-extrabold text-white">Aggiornamenti</h2>
                            </div>
                        </div>
                        <div class="space-y-3 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                La presente informativa potrà essere modificata o aggiornata in qualsiasi momento in
                                base all'evoluzione tecnica del sito o alle normative vigenti.
                            </p>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Building className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 05</span>
                                <h2 class="text-xl font-extrabold text-white">Titolare del Trattamento</h2>
                            </div>
                        </div>
                        <div class="grid sm:grid-cols-2 gap-6 text-sm text-zinc-300 font-light pl-0 sm:pl-15">
                            <div class="space-y-3">
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Attività:</strong>
                                    <span class="text-white font-medium">Fabbro Lissone</span>
                                    <span class="block text-xs text-zinc-400 mt-0.5">marchio di proprietà di Luciano, P.IVA 09082580961</span>
                                </div>
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Partita IVA:</strong>
                                    <span class="text-white font-medium">09082580961</span>
                                </div>
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Sede legale:</strong>
                                    <span class="text-white font-medium">Via Gran Paradiso 4, Brugherio</span>
                                </div>
                            </div>
                            <div class="space-y-3">
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Telefono:</strong>
                                    <a href="tel:3333102133" class="text-sky-400 font-bold hover:underline">333 310
                                        2133</a>
                                </div>
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Email:</strong>
                                    <a href="mailto:info@lissoneserrature.it"
                                       class="text-sky-400 font-bold hover:underline">info@lissoneserrature.it</a>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="rounded-3xl bg-zinc-950/60 p-6 border border-zinc-800/80 text-xs text-zinc-400 font-light space-y-2">
                        <div class="flex items-center gap-2 text-white font-bold uppercase tracking-wider">
                            <AlertTriangle className="w-4 h-4 text-sky-400"/>
                            Nota Tecnica
                        </div>
                        <p class="leading-relaxed">
                            Il Webmaster fornisce esclusivamente il supporto tecnico e la gestione dello spazio server.
                            Il Webmaster non è responsabile dei contenuti commerciali o delle trattative intercorse tra
                            gli utenti e l'azienda, restando quest'ultima l'unica responsabile per i servizi erogati e
                            il trattamento dei dati.
                        </p>
                    </div>

                </div>

            </div>
        </main>

        <footer id="footer">
            <Footer/>
        </footer>
    </div>
</Layout>
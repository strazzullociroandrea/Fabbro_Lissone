---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {AlertTriangle, Building, FileText, ArrowLeft, Phone, Shield} from "lucide-react";
---

<Layout title="Termini e Condizioni di Servizio | Fabbro Lissone">
    <div class="min-h-screen flex flex-col justify-between bg-zinc-950 text-white selection:bg-sky-500 selection:text-white">
        <header id="header" class="sticky top-0 z-50 bg-zinc-950/90 backdrop-blur-xl border-b border-zinc-800/80">
            <Header/>
        </header>

        <main id="main" class="grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 w-full">

            <div class="mb-12">
                <a
                        href="javascript:history.back()"
                        class="inline-flex items-center space-x-2.5 px-4 py-2.5 rounded-2xl bg-zinc-900/90 hover:bg-zinc-800 text-zinc-300 hover:text-white font-medium text-xs tracking-wider uppercase transition-all border border-zinc-800 shadow-lg active:scale-95 group cursor-pointer"
                >
                    <ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1 text-sky-400"/>
                    <span>Torna Indietro</span>
                </a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

                <div class="lg:col-span-4 lg:sticky lg:top-28 space-y-6">
                    <div class="inline-flex items-center justify-center p-3.5 bg-sky-500/10 rounded-2xl text-sky-400 border border-sky-500/20 shadow-xl shadow-sky-950/50">
                        <FileText className="w-8 h-8"/>
                    </div>

                    <h1 class="text-4xl sm:text-5xl font-black tracking-tight leading-[1.05] text-white">
                        Termini e <span class="text-transparent bg-clip-text bg-linear-to-r from-sky-400 to-blue-500">Condizioni</span>
                    </h1>

                    <p class="text-zinc-400 text-base leading-relaxed font-light">
                        Benvenuto sul nostro sito web. Ti invitiamo a leggere attentamente questi Termini e Condizioni
                        prima di utilizzare i nostri servizi.
                    </p>

                    <div class="pt-4 border-t border-zinc-800/80 flex flex-col gap-3">
                        <div class="flex items-center gap-2 text-xs text-zinc-400 font-medium">
                            <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
                            <span>Ultimo aggiornamento: 05 ottobre 2026</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-8 space-y-10">

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Shield className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 01</span>
                                <h2 class="text-xl font-extrabold text-white">Accettazione dei Termini</h2>
                            </div>
                        </div>
                        <div class="space-y-3 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                Accedendo e utilizzando i servizi di <strong class="text-white font-medium">Fabbro
                                Lissone</strong>, accetti i seguenti Termini e Condizioni. Se non sei d'accordo con
                                queste condizioni, ti invitiamo a non utilizzare il nostro sito web.
                            </p>
                            <p class="text-zinc-400">
                                L'utilizzo dei nostri servizi implica l'accettazione integrale di tutti i termini e
                                condizioni qui riportati, incluse le politiche di privacy e cookie.
                            </p>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <FileText className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 02</span>
                                <h2 class="text-xl font-extrabold text-white">Modifiche ai Termini</h2>
                            </div>
                        </div>
                        <div class="space-y-3 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                <strong class="text-white font-medium">Fabbro Lissone</strong> si riserva il diritto di
                                modificare questi Termini e Condizioni in qualsiasi momento per adeguarli alle normative
                                vigenti o ai cambiamenti dei servizi offerti.
                            </p>
                            <p class="text-zinc-400">
                                Le modifiche saranno pubblicate su questa pagina e diventeranno effettive immediatamente
                                dopo la pubblicazione.
                            </p>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Building className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 03</span>
                                <h2 class="text-xl font-extrabold text-white">Uso del Sito</h2>
                            </div>
                        </div>
                        <div class="grid sm:grid-cols-2 gap-4 text-sm text-zinc-300 font-light pl-0 sm:pl-15">
                            <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800/80">
                                <h3 class="font-bold text-white mb-2 flex items-center gap-2">✅ Uso Consentito</h3>
                                <ul class="space-y-1.5 text-xs text-zinc-400">
                                    <li>• Consultazione informazioni sui servizi</li>
                                    <li>• Richiesta preventivi</li>
                                    <li>• Contatto telefonico</li>
                                    <li>• Utilizzo conforme alle leggi applicabili</li>
                                </ul>
                            </div>
                            <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800/80">
                                <h3 class="font-bold text-white mb-2 flex items-center gap-2">❌ Uso Vietato</h3>
                                <ul class="space-y-1.5 text-xs text-zinc-400">
                                    <li>• Violazione dei diritti di proprietà intellettuale</li>
                                    <li>• Utilizzo per scopi illeciti o fraudolenti</li>
                                    <li>• Invio di contenuti offensivi o spam</li>
                                    <li>• Tentativi di compromettere la sicurezza</li>
                                </ul>
                            </div>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Shield className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 04</span>
                                <h2 class="text-xl font-extrabold text-white">Proprietà Intellettuale</h2>
                            </div>
                        </div>
                        <div class="space-y-3 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                Tutti i contenuti del sito web di <strong class="text-white font-medium">Fabbro
                                Lissone</strong> sono protetti dalle leggi sul diritto d'autore. È vietata la
                                riproduzione, distribuzione o utilizzo non autorizzato di qualsiasi materiale presente.
                            </p>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <AlertTriangle className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 05</span>
                                <h2 class="text-xl font-extrabold text-white">Limitazione di Responsabilità</h2>
                            </div>
                        </div>
                        <div class="space-y-3 text-sm text-zinc-300 font-light leading-relaxed pl-0 sm:pl-15">
                            <p>
                                <strong class="text-white font-medium">Fabbro Lissone</strong> non sarà responsabile per
                                danni diretti o indiretti derivanti dall'uso del sito web, fatta salva la responsabilità
                                diretta per i servizi di fabbro effettivamente prestati sul campo.
                            </p>
                        </div>
                    </section>

                    <section
                            class="group relative rounded-3xl bg-zinc-900/40 hover:bg-zinc-900/80 p-8 border border-zinc-800/80 transition-all duration-300">
                        <div class="absolute top-0 left-8 right-8 h-px bg-linear-to-r from-transparent via-sky-500/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="flex items-start gap-4 mb-6">
                            <div class="p-3 bg-zinc-800/80 rounded-2xl text-sky-400 border border-zinc-700/50 shrink-0">
                                <Phone className="w-5 h-5"/>
                            </div>
                            <div>
                                <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-widest block mb-1">Sezione 06</span>
                                <h2 class="text-xl font-extrabold text-white">Contatti e Riferimenti</h2>
                            </div>
                        </div>
                        <div class="grid sm:grid-cols-2 gap-6 text-sm text-zinc-300 font-light pl-0 sm:pl-15">
                            <div class="space-y-3">
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Attività:</strong>
                                    <span class="text-white font-medium">Fabbro Lissone</span>
                                    <span class="block text-xs text-zinc-400 mt-0.5">marchio di proprietà di Luciano, P.IVA 09082580961</span>
                                </div>
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Partita IVA:</strong>
                                    <span class="text-white font-medium">09082580961</span>
                                </div>
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Sede legale:</strong>
                                    <span class="text-white font-medium">Via Gran Paradiso 4, Brugherio</span>
                                </div>
                            </div>
                            <div class="space-y-3">
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Telefono:</strong>
                                    <a href="tel:3333102133" class="text-sky-400 font-bold hover:underline">333 310
                                        2133</a>
                                </div>
                                <div>
                                    <strong class="text-zinc-500 text-xs uppercase block mb-0.5">Email:</strong>
                                    <a href="mailto:info@lissoneserrature.it"
                                       class="text-sky-400 font-bold hover:underline">info@lissoneserrature.it</a>
                                </div>
                            </div>
                        </div>
                    </section>

                    <div class="rounded-3xl bg-zinc-950/60 p-6 border border-zinc-800/80 text-xs text-zinc-400 font-light space-y-2">
                        <div class="flex items-center gap-2 text-white font-bold uppercase tracking-wider">
                            <AlertTriangle className="w-4 h-4 text-sky-400"/>
                            Nota Tecnica
                        </div>
                        <p class="leading-relaxed">
                            Il Webmaster fornisce esclusivamente il supporto tecnico e la gestione dello spazio server.
                            Il Webmaster non è responsabile dei contenuti commerciali o delle trattative intercorse tra
                            gli utenti e l'azienda, restando quest'ultima l'unica responsabile per i servizi erogati.
                        </p>
                    </div>

                </div>

            </div>
        </main>

        <footer id="footer">
            <Footer/>
        </footer>
    </div>
</Layout>